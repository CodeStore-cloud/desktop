<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.Scene?>
<?import javafx.stage.Stage?>
<Stage xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1"
       fx:controller="cloud.codestore.core.application.synchronization.CloudSelectionDialog"
       resizable="false" title="%dialog.cloud.title" fx:id="window">
    <scene>
        <Scene>
            <VBox spacing="10.0">
                <padding>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                </padding>

                <Label text="%dialog.cloud.message"/>
                <ComboBox fx:id="cloudServiceSelection"/>
                <ButtonBar>
                    <buttons>
                        <Button text="%dialog.button.ok" alignment="BOTTOM_RIGHT" onAction="#ok"/>
                    </buttons>
                </ButtonBar>
            </VBox>
        </Scene>
    </scene>
</Stage>
